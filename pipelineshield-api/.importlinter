[importlinter]
root_packages =
    pipelineshield

[importlinter:contract:scoring-core-no-framework]
name = Scoring core must not import framework modules
type = forbidden
source_modules =
    pipelineshield.analysis.scoring
forbidden_modules =
    fastapi
    sqlalchemy
    httpx
    requests
    aiohttp
    uvicorn
    starlette

[importlinter:contract:analysis-core-no-persistence]
name = Analysis core must not import persistence layer
type = forbidden
source_modules =
    pipelineshield.analysis
forbidden_modules =
    pipelineshield.persistence
